    {
      "name": "2. Chat & Customer Service",
      "item": [
        {
          "name": "Get All Chat Sessions (Inbox List)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/chats?platform=all&search=",
              "host": ["{{base_url}}"],
              "path": ["api", "chats"],
              "query": [
                { "key": "platform", "value": "all" },
                { "key": "search", "value": "" }
              ]
            }
          }
        },
        {
          "name": "Get Chat Messages by Session ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/chats/1/messages",
              "host": ["{{base_url}}"],
              "path": ["api", "chats", "1", "messages"]
            }
          }
        },
        {
          "name": "Send CS Reply (Menghitung first_response_ms & Reset Unread)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"Halo kak! Jaket Stormbreaker ukuran L dan celana cargo ukuran 32 ready siap kirim hari ini ya kak. Mau kami buatkan pesanannya langsung?\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/chats/1/messages",
              "host": ["{{base_url}}"],
              "path": ["api", "chats", "1", "messages"]
            }
          }
        },
        {
          "name": "Update Chat Status (Resolve / Open)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"resolved\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/chats/1/status",
              "host": ["{{base_url}}"],
              "path": ["api", "chats", "1", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Customer Intelligence & Orders",
      "item": [
        {
          "name": "Get Customer Detail (Profile, LTV, Loyalty, 5 History, Tags)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/customers/1",
              "host": ["{{base_url}}"],
              "path": ["api", "customers", "1"]
            }
          }
        },
        {
          "name": "Create Manual Order (CS WhatsApp Order)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": 1,\n  \"platform\": \"whatsapp\",\n  \"status\": \"paid\",\n  \"items\": [\n    {\n      \"sku\": \"RS-GLV-GDE-BLK-L\",\n      \"qty\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/orders",
              "host": ["{{base_url}}"],
              "path": ["api", "orders"]
            },
            "description": "Memotong stok global di 4 platform inventory channel, memperbarui LTV dan automated tags (VIP, dll), mengirim pesan konfirmasi otomatis ke sesi WhatsApp pelanggan."
          }
        },
        {
          "name": "Update Order Status (Trigger Auto-Tagging)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"returned\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/orders/1/status",
              "host": ["{{base_url}}"],
              "path": ["api", "orders", "1", "status"]
            },
            "description": "Mengubah status order. Jika status diubah menjadi 'returned' >= 2 kali, pelanggan otomatis memperoleh tag 'Suka Retur'."
          }
        },
        {
          "name": "Get All Products & Multi-Channel Stocks",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/products",
              "host": ["{{base_url}}"],
              "path": ["api", "products"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Analytics & Demo Lab",
      "item": [
        {
          "name": "Get Dashboard Analytics (Executive KPIs, Sales %, Low Stock Alerts)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/analytics/dashboard",
              "host": ["{{base_url}}"],
              "path": ["api", "analytics", "dashboard"]
            },
            "description": "Mengambil metrik ringkasan eksekutif, persentase penjualan per saluran yang dihitung akurat dari tabel orders, tren 30 hari, daftar alert stok kritis, dan performa CS."
          }
        },
        {
          "name": "Reset Demo Data ke Kondisi Awal",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/demo/reset",
              "host": ["{{base_url}}"],
              "path": ["api", "demo", "reset"]
            },
            "description": "Mereset basis data ke kondisi awal seeder secara in-memory/in-process dan menyiarkan event 'demo:reset' via Socket.io ke semua browser yang sedang terhubung."
          }
        }
      ]
    }
  ]
