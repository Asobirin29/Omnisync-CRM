{
  "info": {
    "_postman_id": "c62b5d4e-8622-498c-a17a-5df977e8a931",
    "name": "OmniSync CRM - API & Webhooks Collection",
    "description": "Koleksi API & Mock Webhooks untuk OmniSync CRM (Studi Kasus: Rancaekek Supply Co.). Digunakan untuk simulasi pesanan masuk, pesan pelanggan lintas marketplace (Shopee, Tokopedia, Lazada, Blibli, WhatsApp), sinkronisasi inventori real-time, manajemen CS, dan analitik toko.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Mock Webhooks",
      "description": "Endpoint mock webhooks untuk mensimulasikan order masuk dan pesan masuk dari berbagai kanal marketplace.",
      "item": [
        {
          "name": "Shopee",
          "item": [
            {
              "name": "Order Masuk - Shopee (Simulasi Pemotongan Stok Multi-Kanal)",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"external_order_id\": \"SHP-ORDER-20261001-001\",\n  \"customer\": {\n    \"name\": \"Budi Santoso\",\n    \"phone\": \"0812-1111-2222\"\n  },\n  \"items\": [\n    {\n      \"sku\": \"RS-FLC-RNJ-GRY-M\",\n      \"qty\": 1\n    }\n  ],\n  \"status\": \"paid\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/webhooks/shopee/order",
                  "host": ["{{base_url}}"],
                  "path": ["api", "webhooks", "shopee", "order"]
                },
                "description": "Simulasi order marketplace Shopee. Memotong stok SKU bersangkutan di SEMUA channel (Shopee, Tokopedia, Lazada, Blibli) dalam 1 transaksi DB ACID dengan latensi < 2 detik dan menyiarkan pembaruan via Socket.io."
              }
            },
            {
              "name": "Pesan Masuk - Shopee",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"customer\": {\n    \"name\": \"Budi Santoso\",\n    \"phone\": \"0812-1111-2222\"\n  },\n  \"message\": \"Halo min, jaket polar Rinjani warna abu ukuran M apakah ada slot pengiriman instant hari ini?\",\n  \"urgency\": \"high\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/webhooks/shopee/message",
                  "host": ["{{base_url}}"],
                  "path": ["api", "webhooks", "shopee", "message"]
                },
                "description": "Simulasi pesan obrolan pelanggan dari platform Shopee. Otomatis masuk antrean inbox omni-channel dengan badge oranye Shopee."
              }
            }
          ]
        },
